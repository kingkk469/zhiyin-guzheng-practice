{
  "name": "zhiyin-guzheng-practice",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build:review && next dev --hostname 127.0.0.1 --port 3219",
    "build": "npm run build:review && next build",
    "build:pages": "npm run build:review && next build",
    "start": "next start --hostname 127.0.0.1 --port 3219",
    "test": "node --test --test-isolation=none tests/music-core.test.mjs tests/practice.test.mjs tests/capture.test.mjs tests/tuning-sweep.test.mjs tests/pitch-detector.test.mjs tests/score-motion.test.mjs tests/fine-tuning.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:sites": "npm run build:review && vinext build",
    "test:render": "node --test --test-isolation=none tests/rendered-html.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:audio": "node tests/browser-audio.mjs",
    "typecheck": "tsc --noEmit",
    "test:sweep": "node tests/browser-sweep.mjs",
    "build:review": "node scripts/build-review.mjs"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@tensorflow/tfjs-backend-wasm": "3.21.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pitchy": "4.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
